# Copy to .env for local development. mise loads it for tasks, and the server reads it on startup.
DATABASE_URL=postgres://baby_greens:baby_greens@localhost:5432/baby_greens
BIND_ADDR=127.0.0.1:3000
RUST_LOG=baby_greens_server=debug,tower_http=debug,info

# Path to the built frontend. Leave unset in development, where Vite serves the frontend.
# WEB_DIST=web/dist

# The origin you open in the browser. In development that's the Vite dev server.
PUBLIC_URL=http://localhost:5173

# OIDC provider. These values match dev/dex.yaml.
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=baby-greens
OIDC_CLIENT_SECRET=dev-client-secret
# Only let members of this group sign in. Leave empty to allow anyone the provider authenticates.
OIDC_ALLOWED_GROUP=
