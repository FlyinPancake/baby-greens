  "query": "\n        SELECT t.done_at, b.status AS \"status: BatchStatus\"\n        FROM tasks t\n        JOIN batches b ON b.id = t.batch_id\n        WHERE t.id = $1 AND b.user_id = $2\n        FOR UPDATE OF t\n        ",
