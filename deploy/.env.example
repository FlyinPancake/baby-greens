# Copy to .env next to compose.yaml and fill in. See docs/deploy.md.

# The image CI publishes. Pin a tag like sha-<commit> to upgrade on your own schedule.
BABY_GREENS_IMAGE=ghcr.io/flyinpancake/baby-greens:latest

# The HTTPS origin people open, served by your reverse proxy. No path, no trailing slash.
PUBLIC_URL=https://greens.example.com
# Where the proxy reaches the app on this host. Use 0.0.0.0:3000 if the proxy runs elsewhere.
APP_BIND=127.0.0.1:3000

# Make one with `openssl rand -hex 24`. Only used inside the stack.
POSTGRES_PASSWORD=

# The Authentik provider's issuer, copied exactly, trailing slash included.
OIDC_ISSUER_URL=https://auth.example.com/application/o/baby-greens/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only let members of this Authentik group sign in. Leave empty to allow anyone who can log in to
# the application.
OIDC_ALLOWED_GROUP=

# Reminders. Make a key with `docker run --rm $BABY_GREENS_IMAGE vapid-key`. Leave empty to turn
# push off. Push services may contact VAPID_SUBJECT about problems with this server.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Nightly database dumps into ./backups. Set COMPOSE_PROFILES=backup to turn them on, or leave it
# empty if something else already backs up this host. They run daily at BACKUP_HOUR in TZ.
COMPOSE_PROFILES=
TZ=UTC
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
